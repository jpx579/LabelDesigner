<Window x:Class="LabelDesigner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:LabelDesigner"
        xmlns:local="clr-namespace:LabelDesigner"
        mc:Ignorable="d" Title="MainWindow" Height="450" Width="800">
    <Window.DataContext>
        <viewModels:MainWindowViewModel/>
    </Window.DataContext>

    <Grid>
        <ContentControl Grid.Row="1" Grid.Column="1" Margin="5" Content="{Binding CurrentContent}"></ContentControl>
    </Grid>
</Window>
